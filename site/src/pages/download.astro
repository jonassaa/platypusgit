---
import Layout from '../layouts/Layout.astro';
import CTAButton from '../components/CTAButton.astro';
import CodeBlock from '../components/CodeBlock.astro';
import OsIcon from '../components/OsIcon.astro';
import { site, assets, apt, scoop, msStore } from '../data/site.ts';
import { descriptions, softwareApplicationSchema, ORIGIN } from '../data/seo.ts';

// The two installer URLs. Built from `site` in astro.config.mjs rather than
// spelled out, so the copy people pipe into a shell cannot drift from the
// canonical origin (the apex domain 301s to www — a redirect a reader of the
// command should not have to reason about). The files themselves are copied
// into public/ by scripts/copy-installers.mjs at build time; there is no
// committed second copy to fall behind scripts/install-pgit.*.
const installBase = Astro.site ?? new URL(ORIGIN);
const installShUrl = new URL('install-pgit.sh', installBase).href;
const installPs1Url = new URL('install-pgit.ps1', installBase).href;
const installAppUrl = new URL('install-platypusgit.sh', installBase).href;

// The Linux one-liner, and the same thing spelled out for anyone who will not
// pipe a URL into a shell. Both built from `apt` in data/site.ts so the page,
// the script's own default, and the seed CNAME cannot drift apart.
const aptOneLiner = `curl -fsSL ${installAppUrl} | sh`;
const aptUpgrade = `sudo apt update && sudo apt upgrade ${apt.pkg}`;
const aptManual = `sudo install -d -m 0755 /etc/apt/keyrings
curl -fsSL ${apt.url}/key.gpg \\
  | sudo tee /etc/apt/keyrings/platypusgit.gpg > /dev/null
sudo chmod 0644 /etc/apt/keyrings/platypusgit.gpg
sudo tee /etc/apt/sources.list.d/platypusgit.sources > /dev/null <<'EOF'
Types: deb
URIs: ${apt.url}
Suites: stable
Components: main
Architectures: amd64
Signed-By: /etc/apt/keyrings/platypusgit.gpg
EOF
sudo apt update && sudo apt install ${apt.pkg}`;
const aptAudit = `curl -fsSL ${installAppUrl} -o install-platypusgit.sh
less install-platypusgit.sh   # read it, then run it
sh install-platypusgit.sh`;

// Windows' package-manager route (#187). Built from `scoop` in data/site.ts so
// the page, the manifest generator and release.yml's bump-scoop cannot drift
// apart on the bucket name.
const scoopInstall = `scoop bucket add ${scoop.bucketName} ${scoop.bucket}
scoop install ${scoop.pkg}`;
const scoopUpgrade = `scoop update ${scoop.pkg}`;

const cliUnix = `curl -fsSL ${installShUrl} | sh`;
const cliWindows = `irm ${installPs1Url} | iex`;
const cliUnixAudit = `curl -fsSL ${installShUrl} -o install-pgit.sh
less install-pgit.sh        # read it, then run it
sh install-pgit.sh`;
const cliWindowsAudit = `irm ${installPs1Url} -OutFile install-pgit.ps1
notepad install-pgit.ps1    # read it, then run it
powershell -ExecutionPolicy Bypass -File .\\install-pgit.ps1`;

const buildSteps = `# Prerequisites: Node 22+, pnpm, Rust stable
#   macOS:   xcode-select --install
#   Linux:   libwebkit2gtk-4.1-dev build-essential libssl-dev
#   Windows: WebView2 + MSVC Build Tools

git clone ${site.repo}.git
cd platypusgit
pnpm install
pnpm tauri build   # produces .dmg / .msi / .deb / .AppImage`;

// Which channels install the `pgit` command as part of installing the app.
// This was three sentences of prose that a reader had to hold in their head to
// answer one question; it is a lookup, so it is a table.
const pgitMatrix = [
  { os: 'macos', channel: 'Homebrew cask', ships: true, note: 'Removed again on uninstall' },
  { os: 'macos', channel: 'Disk image (.dmg)', ships: false, note: 'A drag-install runs no code' },
  { os: 'windows', channel: 'Microsoft Store', ships: true, note: 'Registered as an app alias' },
  { os: 'windows', channel: 'Installer (.msi)', ships: true, note: 'Added to your PATH' },
  { os: 'windows', channel: 'Scoop', ships: true, note: 'Scoop shims it for you' },
  { os: 'linux', channel: 'APT repository', ships: true, note: 'Ships /usr/bin/pgit' },
  { os: 'linux', channel: 'Debian package (.deb)', ships: true, note: 'Same package, same shim' },
  { os: 'linux', channel: 'AppImage', ships: false, note: 'Portable, executes no hook' },
];

// macOS minimum is tauri.conf.json's bundle.macOS.minimumSystemVersion.
const platforms = [
  {
    key: 'macos',
    label: 'macOS',
    iconSize: 20,
    blurb: 'Apple Silicon & Intel, one universal build.',
    specs: ['macOS 11 Big Sur or newer', 'Universal — arm64 + x86_64', 'Ships the pgit command'],
  },
  {
    key: 'windows',
    label: 'Windows',
    iconSize: 18,
    blurb: 'The Store, an installer, or one line with Scoop.',
    // x64 everywhere; Arm64 only through the Store, which is the one channel
    // that ships an arm64 build (release.yml's `msix` job bundles both).
    specs: ['Windows 10 or 11 · x64, Arm64 via the Store', 'WebView2 — preinstalled on 11', 'Ships the pgit command'],
  },
  {
    key: 'linux',
    label: 'Linux',
    iconSize: 20,
    blurb: 'One-line apt install, or a portable AppImage.',
    specs: ['webkit2gtk 4.1 required', 'x86_64', 'apt handles updates'],
  },
] as const;
---
<Layout
  title={'Download ' + site.name + ' for Mac, Windows & Linux'}
  description={descriptions.download}
  schemas={[softwareApplicationSchema]}
>
  {/* Resolve the platform BEFORE the panels below are parsed, so the page
      paints with one panel open instead of rendering all three and collapsing
      two on DOMContentLoaded. The old script also never sniffed at all — it
      returned 'macos' unconditionally, so every Windows and Linux visitor
      landed on Homebrew instructions. */}
  <script is:inline>
    (function () {
      var known = ['macos', 'windows', 'linux'];
      var hash = (location.hash || '').replace('#', '');
      if (known.indexOf(hash) !== -1) {
        document.documentElement.setAttribute('data-os', hash);
        return;
      }
      var ua = navigator.userAgent || '';
      var plat = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || '';
      var hay = plat + ' ' + ua;
      // Apple first: iPadOS reports "like Mac OS X" and Android reports "Linux".
      var os = /mac|iphone|ipad|ipod/i.test(hay)
        ? 'macos'
        : /win/i.test(hay)
          ? 'windows'
          : /linux|x11|cros|android|bsd/i.test(hay)
            ? 'linux'
            : 'macos';
      document.documentElement.setAttribute('data-os', os);
    })();
  </script>

  <section class="container page-head">
    <p class="eyebrow mono">Free · GPL-3.0 · no account, no telemetry</p>
    <h1>Download platypusgit</h1>
    <p class="lead">
      Prebuilt binaries for macOS, Windows and Linux on every release. Pick a platform —
      yours is already selected.
    </p>
    <div class="head-ctas">
      <CTAButton href={site.releasesLatest} external>Latest release ↗</CTAButton>
      <CTAButton href={site.releases} variant="secondary" external>All releases ↗</CTAButton>
    </div>
    <p class="head-note">
      Builds are early but usable — expect frequent releases and rough edges. We have not bought a
      signing certificate, so most of these need one extra step on first launch on macOS and
      Windows; each panel says which. The one exception is the Microsoft Store build, which
      Microsoft signs on our behalf.
    </p>
  </section>

  <!-- PLATFORM PICKER — tablist joined to the panel it controls -->
  <section class="container picker">
    <div class="tabs" role="tablist" aria-label="Operating system">
      {platforms.map((p) => (
        <button
          class="tab"
          role="tab"
          type="button"
          id={`tab-${p.key}`}
          data-os={p.key}
          aria-controls={`panel-${p.key}`}
          aria-selected="false"
        >
          <OsIcon os={p.key} size={15} />
          {p.label}
        </button>
      ))}
    </div>

    {platforms.map((p) => (
      <div
        class="panel"
        role="tabpanel"
        id={`panel-${p.key}`}
        aria-labelledby={`tab-${p.key}`}
        data-os-section={p.key}
        tabindex="0"
      >
        <div class="panel-head">
          <h2 id={p.key}><OsIcon os={p.key} size={p.iconSize} /> {p.label}</h2>
          <p>{p.blurb}</p>
        </div>

        <div class="grid">
          {/* ── macOS ─────────────────────────────────────────────── */}
          {p.key === 'macos' && (
            <>
              <article class="card card-wide card-primary">
                <span class="pill">Recommended</span>
                <h3>Homebrew</h3>
                <p class="card-lead">One command to install, one to update, and no Gatekeeper detour.</p>
                <CodeBlock code={'brew install --cask jonassaa/platypusgit/platypusgit'} lang="bash" />
                <p class="card-note">
                  Taps the cask and installs the universal build straight into <code>/Applications</code>,
                  and the <a href="#cli"><code>pgit</code></a> command with it. The app is ad-hoc signed
                  but not notarized — the cask clears the macOS Gatekeeper quarantine flag on install, so
                  it launches with no “unidentified developer” prompt and there is nothing to run by hand.
                </p>
                <details>
                  <summary>Updating and removing</summary>
                  <p class="card-note">
                    Homebrew owns updates on macOS — there is no in-app self-update. Every release bumps
                    the cask, so upgrading is:
                  </p>
                  <CodeBlock code={'brew update\nbrew upgrade --cask platypusgit'} lang="bash" />
                  <p class="card-note">
                    <code>brew update</code> refreshes the tap, <code>brew upgrade</code> fetches the new
                    build and replaces the app. Quit platypusgit first so the running app isn’t swapped
                    underneath it. Check what you have with <code>brew info --cask platypusgit</code>, and
                    remove it with <code>brew uninstall --cask platypusgit</code>.
                  </p>
                </details>
              </article>

              <article class="card">
                <h3>Disk image</h3>
                <p class="card-lead">No Homebrew? Drag-install the universal build.</p>
                <CTAButton href={assets.macosDmg} external>Download .dmg</CTAButton>
                <p class="filename mono">PlatypusGit_universal.dmg</p>
                <p class="card-note">
                  Drag <code>platypusgit.app</code> into <code>/Applications</code>. Updates are then
                  manual — repeat the download for every release — and because a drag-install runs no
                  code, the <a href="#cli"><code>pgit</code></a> command is a separate one-liner.
                </p>
                <details>
                  <summary>First launch warning</summary>
                  <p class="card-note">
                    The <code>.dmg</code> isn’t notarized, so macOS may say the app is damaged or from an
                    unidentified developer. Clear the quarantine flag — Homebrew installs never hit this:
                  </p>
                  <CodeBlock code={'xattr -cr /Applications/platypusgit.app'} lang="bash" />
                  <p class="card-note">
                    Or: <strong>System Settings → Privacy &amp; Security → Open Anyway</strong>.
                  </p>
                </details>
              </article>
            </>
          )}

          {/* ── Windows ───────────────────────────────────────────── */}
          {p.key === 'windows' && (
            <>
              <article class="card card-wide card-primary">
                <span class="pill">Recommended</span>
                <h3>Installer</h3>
                <p class="card-lead">Download the 64-bit installer and run it.</p>
                <CTAButton href={assets.windowsMsi} external>Download .msi</CTAButton>
                <p class="filename mono">PlatypusGit_x64.msi</p>
                <p class="card-note">
                  Installs the app and the <a href="#cli"><code>pgit</code></a> command together, and puts
                  <code>pgit</code> on your PATH. WebView2 is already present on Windows 11; on Windows 10
                  the installer pulls it in if it is missing. This is the route that updates itself —
                  platypusgit offers the new version in-app and installs it for you.
                </p>
                <details>
                  <summary>First launch warning</summary>
                  <p class="card-note">
                    The installer isn’t code-signed yet, so Windows SmartScreen shows a warning. Click
                    <strong>More info → Run anyway</strong> to proceed.
                  </p>
                </details>
              </article>

              <article class="card card-wide">
                <h3>Microsoft Store</h3>
                <p class="card-lead">
                  The one Windows route with no SmartScreen warning — Microsoft signs the package
                  itself — and the only one that runs natively on Arm.
                </p>
                {/* The badge is Microsoft's own web component, so the button looks like every
                    other Store button a Windows user has clicked. It renders an iframe from
                    get.microsoft.com, which means it needs the network and a script to appear at
                    all; the plain link below it is not decoration, it is what a reader with the
                    script blocked actually uses. */}
                <div class="store-badge">
                  <ms-store-badge
                    productid={msStore.productId}
                    productname={site.name}
                    window-mode="direct"
                    theme="auto"
                    size="large"
                    language="en-us"
                    animation="on"
                  ></ms-store-badge>
                  <a class="store-link" href={msStore.listing} target="_blank" rel="noopener">
                    Open the Store listing ↗
                  </a>
                </div>
                <p class="card-note">
                  One package for x64 <em>and</em> Arm64, so this is the route for a Copilot+ PC or any
                  other Windows-on-Arm machine — the <code>.msi</code> above is x64 only. You get the
                  app and the <a href="#cli"><code>pgit</code></a> command together, and because
                  Microsoft re-signs everything it distributes, nothing warns you on first launch.
                </p>
                <details>
                  <summary>Updating and removing</summary>
                  <p class="card-note">
                    The Store owns updates on this install, and the app knows it — the in-app updater
                    is switched off here, the same way it is under Scoop, so the two can never
                    disagree about which copy you are running. Windows updates Store apps on its own;
                    to do it now, open the Store and choose <strong>Library → Get updates</strong>.
                  </p>
                  <p class="card-note">
                    Every release goes through Microsoft's certification before it appears here, so
                    this channel can trail a brand-new version by a little. If you want a release the
                    day it ships, take the <code>.msi</code>.
                  </p>
                  <p class="card-note">
                    Removing it is <strong>Settings → Apps → platypusgit → Uninstall</strong>. An MSIX
                    is a sealed package Windows manages rather than an installer that scatters files,
                    so nothing is left behind.
                  </p>
                </details>
                <details>
                  <summary>WebView2, and what this package cannot do for you</summary>
                  <p class="card-note">
                    Like the Scoop build, the Store package does not carry the WebView2 bootstrapper —
                    a Store app is not allowed to run one. Windows 11 ships WebView2 and Windows 10
                    gets it with Edge, so it is almost certainly already there; if no window appears,
                    install the Evergreen WebView2 Runtime from Microsoft.
                  </p>
                </details>
              </article>

              <article class="card card-wide">
                <h3>Scoop</h3>
                <p class="card-lead">Already using Scoop? Two lines, no admin prompt, and <code>scoop update</code> for every release after.</p>
                <CodeBlock code={scoopInstall} lang="powershell" />
                <p class="card-note">
                  Installs per-user, so nothing asks for elevation and
                  <code>scoop uninstall {scoop.pkg}</code> removes every trace. You get the app with a
                  Start Menu shortcut, and <a href="#cli"><code>pgit</code></a> shimmed onto your PATH by
                  Scoop itself. Needs <a href="https://scoop.sh" target="_blank" rel="noopener">Scoop</a>
                  first — if you don’t have it, take the installer above instead.
                </p>
                <details>
                  <summary>Updating and removing</summary>
                  <p class="card-note">
                    Scoop owns updates on this install, and the app knows it — the in-app updater is
                    switched off here, so the two can never disagree about which copy you are running.
                    Upgrading is:
                  </p>
                  <CodeBlock code={scoopUpgrade} lang="powershell" />
                  <p class="card-note">
                    Quit platypusgit first so the running app isn’t swapped underneath it.
                  </p>
                </details>
                <details>
                  <summary>WebView2, and what this package cannot do for you</summary>
                  <p class="card-note">
                    Scoop installs a portable build rather than running the <code>.msi</code>, which is
                    what makes it per-user and cleanly removable — but it also means it cannot install the
                    WebView2 runtime the way the installer can. Windows 11 ships WebView2 and Windows 10
                    gets it with Edge, so it is almost certainly already there; if no window appears,
                    install the Evergreen WebView2 Runtime from Microsoft.
                  </p>
                </details>
              </article>

              <article class="card">
                <h3>Other routes</h3>
                <p class="card-lead">No winget or Chocolatey package yet.</p>
                <p class="card-note">
                  <code>winget</code> is waiting on code signing — an unsigned installer means SmartScreen
                  warnings and a harder time through winget’s review, so it is a certificate away rather
                  than a build away. Chocolatey isn’t planned. If you would rather not run the installer
                  at all, <a href="#build">build from source</a> — the standard Tauri toolchain produces
                  the same <code>.msi</code>.
                </p>
              </article>
            </>
          )}

          {/* ── Linux ─────────────────────────────────────────────── */}
          {p.key === 'linux' && (
            <>
              <article class="card card-wide card-primary">
                <span class="pill">Recommended</span>
                <h3>One-line install</h3>
                <p class="card-lead">Debian, Ubuntu and derivatives. One command to install, and apt for every release after.</p>
                <CodeBlock code={aptOneLiner} lang="bash" />
                <p class="card-note">
                  Adds our signed APT repository and installs the app. The package ships
                  <code>/usr/bin/pgit</code>, so the <a href="#cli"><code>pgit</code></a> command works
                  straight away, and <code>webkit2gtk 4.1</code> comes with it as a dependency. The
                  signing key is served pre-dearmored, so you need no <code>gnupg</code> — this works on
                  a bare container or cloud image. On a system without <code>apt</code>, or on an
                  architecture we don’t build yet, it says so and stops rather than quietly installing
                  something else.
                </p>
                <details>
                  <summary>Updating and removing</summary>
                  <p class="card-note">
                    Your package manager owns updates once the repository is added — a <code>.deb</code>
                    cannot replace its own files, so there is no in-app self-update here. Every release
                    publishes to the repository, so upgrading is:
                  </p>
                  <CodeBlock code={aptUpgrade} lang="bash" />
                  <p class="card-note">
                    Quit platypusgit first so the running app isn’t swapped underneath it. The package is
                    called <code>{apt.pkg}</code> — that is the name <code>apt search</code>,
                    <code>apt remove</code> and <code>dpkg -l</code> use. <code>apt install platypusgit</code>
                    works too, because the package declares that name as well, but <code>{apt.pkg}</code>
                    is the one to remember. Remove it with <code>sudo apt remove {apt.pkg}</code>.
                  </p>
                </details>
                <details>
                  <summary>The same thing, spelled out</summary>
                  <p class="card-note">
                    The one-liner does exactly this. Run it yourself if you would rather not pipe a URL
                    into a shell:
                  </p>
                  <CodeBlock code={aptManual} lang="bash" />
                  <p class="card-note">
                    <code>Signed-By:</code> scopes the key to this one repository — never
                    <code>apt-key add</code>, which is deprecated and gone on current Debian and Ubuntu.
                    {apt.keyFingerprint ? (
                      <> Verify the key before you trust it: its fingerprint is <code>{apt.keyFingerprint}</code>.</>
                    ) : (
                      <> Check the key you were served against the one published at <a href={apt.url} target="_blank" rel="noopener">{apt.url.replace('https://', '')}</a> — <code>gpg --show-keys /etc/apt/keyrings/platypusgit.gpg</code> prints its fingerprint.</>
                    )}
                  </p>
                </details>
                <details>
                  <summary>Read the installer first, or dry-run it</summary>
                  <p class="card-note">
                    Piping a URL into a shell runs whatever that URL returns, so
                    <a href={installAppUrl}>install-platypusgit.sh</a> is plain text meant to be read
                    first — and the same bytes live in the repo under
                    <a href={site.repo + '/tree/main/scripts'} target="_blank" rel="noopener">scripts/</a>,
                    because the site serves a build-time copy of exactly that file. Or download, inspect,
                    then run:
                  </p>
                  <CodeBlock code={aptAudit} lang="bash" />
                  <p class="card-note">
                    It also takes a dry run that prints what it would do and changes nothing:
                    <code>curl -fsSL … | sh -s -- --dry-run</code>.
                  </p>
                </details>
              </article>

              <article class="card">
                <h3>AppImage</h3>
                <p class="card-lead">Fedora, Arch, and anything not Debian-based.</p>
                <CTAButton href={assets.linuxAppImage} external>Download .AppImage</CTAButton>
                <p class="filename mono">PlatypusGit_amd64.AppImage</p>
                <CodeBlock code={'chmod +x PlatypusGit_amd64.AppImage\n./PlatypusGit_amd64.AppImage'} lang="bash" />
                <p class="card-note">
                  Download, make it executable, run — nothing is installed.
                  <strong>This is the only Linux build that updates itself:</strong> an AppImage can
                  replace its own file, so platypusgit offers the update in-app, which is exactly what the
                  <code>.deb</code> cannot do. Because nothing is installed and no hook executes, the
                  <a href="#cli"><code>pgit</code></a> command is a separate one-liner.
                </p>
              </article>

              <article class="card">
                <h3>Debian package, by hand</h3>
                <p class="card-lead">For an air-gapped box, or a one-off.</p>
                <CTAButton href={assets.linuxDeb} external>Download .deb</CTAButton>
                <p class="filename mono">PlatypusGit_amd64.deb</p>
                <CodeBlock code={'sudo apt install ./PlatypusGit_amd64.deb'} lang="bash" />
                <p class="card-note">
                  The same package the repository serves, installed straight from the file. Updates are
                  then manual — repeat the download for every release, because apt has no repository to
                  upgrade from. platypusgit notices, and offers you the one-liner above rather than
                  pretending <code>apt upgrade</code> will work.
                </p>
              </article>
            </>
          )}

          <aside class="card card-specs">
            <h3>Requirements</h3>
            <ul>{p.specs.map((s) => <li>{s}</li>)}</ul>
          </aside>
        </div>
      </div>
    ))}
  </section>

  <!-- THE pgit COMMAND -->
  <section class="container section" id="cli">
    <p class="eyebrow mono">Command line</p>
    <h2>The <code>pgit</code> command</h2>
    <p class="lead">
      <code>pgit .</code> opens the repository you are standing in and hands the prompt straight
      back. <code>pgit log</code>, <code>pgit commit</code> and <code>pgit branches</code> open onto
      that screen; a path opens the repository containing it.
    </p>

    <h3 class="sub">Most installs already have it</h3>
    <div class="matrix" role="table" aria-label="Which install channels ship the pgit command">
      <div class="mrow mhead" role="row">
        <span role="columnheader">Channel</span>
        <span role="columnheader">Ships <code>pgit</code></span>
        <span role="columnheader">Notes</span>
      </div>
      {pgitMatrix.map((r) => (
        <div class="mrow" role="row" data-ships={String(r.ships)}>
          <span role="cell"><OsIcon os={r.os} size={13} /> {r.channel}</span>
          <span role="cell" class="ships">{r.ships ? 'Yes' : 'No'}</span>
          <span role="cell" class="mnote">{r.note}</span>
        </div>
      ))}
    </div>
    <p class="matrix-note">
      Check with <code>pgit --help</code> in a new terminal. The two channels that run no install
      code need the one-liner below, or <strong>Settings → Command line</strong> inside the app.
    </p>

    <div class="grid grid-2">
      <article class="card">
        <h3>macOS .dmg &amp; Linux AppImage</h3>
        <CodeBlock code={cliUnix} lang="bash" />
        <p class="card-note">
          Links <code>pgit</code> to the app you already installed, from a directory you own — no
          <code>sudo</code>. If Homebrew or the <code>.deb</code> already put a <code>pgit</code> on
          your PATH, the script says so and exits without touching it.
        </p>
      </article>
      <article class="card">
        <h3>Windows PowerShell</h3>
        <CodeBlock code={cliWindows} lang="powershell" />
        <p class="card-note">
          For the Windows installs the <code>.msi</code> does not cover: a build from source, an
          unpacked layout, or an <code>.msi</code> whose PATH change has not reached the shell you are
          in. Writes <code>pgit.cmd</code> into <code>%LOCALAPPDATA%\PlatypusGit\bin</code> and appends
          that directory to your <em>user</em> PATH — no admin rights.
        </p>
      </article>
    </div>

    <details class="audit">
      <summary>Read it before you run it</summary>
      <p class="card-note">
        Piping a URL into a shell runs whatever that URL returns, so both scripts are plain text meant
        to be read first — <a href={installShUrl}>install-pgit.sh</a> and
        <a href={installPs1Url}>install-pgit.ps1</a> open in the browser, and the same files live in
        the repo under <a href={site.repo + '/tree/main/scripts'} target="_blank" rel="noopener">scripts/</a>
        (the site serves a build-time copy of exactly those bytes). Or download, inspect, then run:
      </p>
      <CodeBlock code={cliUnixAudit} lang="bash" />
      <p class="card-note card-note-tight">Windows PowerShell:</p>
      <CodeBlock code={cliWindowsAudit} lang="powershell" />
      <p class="card-note">
        Both take a dry run that prints what would happen and changes nothing:
        <code>curl -fsSL … | sh -s -- --dry-run</code>, or <code>-DryRun</code> for the PowerShell
        script.
      </p>
    </details>
  </section>

  <!-- BUILD FROM SOURCE -->
  <section class="container section" id="build">
    <p class="eyebrow mono">From source</p>
    <h2>Build it yourself</h2>
    <p class="lead">Standard Tauri toolchain. Works on all three platforms, and produces the same artifacts the release workflow publishes.</p>
    <CodeBlock code={buildSteps} lang="bash" />
    <p class="readme-link">
      <a href={site.repo + '#development'} target="_blank" rel="noopener">Full development guide on GitHub →</a>
    </p>
  </section>
</Layout>

{/* Microsoft's Store badge component, loaded from their CDN because that is the
    only place it is published. `is:inline` keeps Astro's bundler out of it: the
    file is a remote third-party module, not something we can usefully process,
    and it is the one asset on this page that is not served from our own origin.
    `type="module"` already defers it, so nothing here blocks first paint — and
    if it never arrives, the plain link inside the card is still there. */}
<script is:inline type="module" src="https://get.microsoft.com/badge/ms-store-badge.bundled.js"></script>

<script is:inline>
  // The badge ships a `theme="auto"`, but "auto" means the OS preference —
  // which is NOT what this site shows. The site defaults to dark and remembers
  // an explicit choice in `pg-site-theme`, so a visitor whose OS is light but
  // whose site is dark would get a light badge in a dark card. Mirror the theme
  // the page is actually rendering instead. `theme` is one of the component's
  // observed attributes, so re-setting it re-renders the badge.
  (function () {
    var root = document.documentElement;
    var badge = document.querySelector('ms-store-badge');
    if (!badge) return;

    function apply() {
      var mode = root.getAttribute('data-theme-mode');
      badge.setAttribute('theme', mode === 'light' ? 'light' : 'dark');
    }

    apply();
    // The toggle sets the attribute directly and fires no event of its own,
    // so observing the attribute is what keeps this in step without reaching
    // into ThemeToggle to add one.
    new MutationObserver(apply).observe(root, {
      attributes: true,
      attributeFilter: ['data-theme-mode'],
    });
  })();
</script>

<script>
  // Tab behaviour only. Which panel is OPEN is decided by the inline script in
  // <head> position above and applied in CSS off html[data-os], so nothing here
  // runs before first paint and there is no layout shift to see.
  (function () {
    var tabs = Array.prototype.slice.call(document.querySelectorAll('.tab'));
    if (!tabs.length) return;
    var known = ['macos', 'windows', 'linux'];
    var root = document.documentElement;

    function current() {
      var os = root.getAttribute('data-os');
      return known.indexOf(os) !== -1 ? os : 'macos';
    }

    // aria-selected is the accessible half of the highlight CSS already draws.
    function sync() {
      var os = current();
      tabs.forEach(function (t) {
        var on = t.getAttribute('data-os') === os;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.setAttribute('tabindex', on ? '0' : '-1');
      });
    }

    function select(os, focus) {
      root.setAttribute('data-os', os);
      sync();
      if (focus) {
        var t = tabs.filter(function (x) { return x.getAttribute('data-os') === os; })[0];
        if (t) t.focus();
      }
    }

    tabs.forEach(function (t) {
      t.addEventListener('click', function () {
        var os = t.getAttribute('data-os');
        select(os, false);
        history.replaceState(null, '', '#' + os);
      });
    });

    // A tablist is one tab stop; arrows move between tabs.
    document.querySelector('.tabs').addEventListener('keydown', function (e) {
      var i = tabs.indexOf(document.activeElement);
      if (i === -1) return;
      var next =
        e.key === 'ArrowRight' || e.key === 'ArrowDown' ? i + 1
        : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? i - 1
        : e.key === 'Home' ? 0
        : e.key === 'End' ? tabs.length - 1
        : -1;
      if (next === -1) return;
      e.preventDefault();
      next = (next + tabs.length) % tabs.length;
      select(tabs[next].getAttribute('data-os'), true);
      history.replaceState(null, '', '#' + tabs[next].getAttribute('data-os'));
    });

    window.addEventListener('hashchange', function () {
      var hash = (location.hash || '').replace('#', '');
      if (known.indexOf(hash) !== -1) select(hash, false);
    });

    sync();
  })();
</script>

<style>
  /* ── page head ─────────────────────────────────────────────── */
  .page-head { padding-top: var(--s-12); }
  .eyebrow { color: var(--accent); font-size: 12px; letter-spacing: 0.04em;
    text-transform: uppercase; margin: 0 0 var(--s-5); }
  .page-head h1 { font-size: 42px; margin: 0 0 var(--s-5); }
  .lead { color: var(--fg-2); font-size: 16px; max-width: 620px; margin: 0; }
  .head-ctas { display: flex; gap: var(--s-4); margin-top: var(--s-7); flex-wrap: wrap; }
  /* The old page put a full notice box here that re-listed every platform and
     format before the panels did the same thing in detail. One paragraph of
     the part a reader cannot get further down. */
  .head-note { color: var(--fg-3); font-size: 13.5px; line-height: 1.6; max-width: 640px;
    margin: var(--s-7) 0 0; padding-left: var(--s-5);
    border-left: 2px solid color-mix(in oklab, var(--accent-2) 55%, transparent); }

  /* ── platform picker ───────────────────────────────────────── */
  /* The tabs used to float above a notice box, with the section they controlled
     starting further down the page — clicking one silently mutated something
     offscreen. Now the row sits ON the panel: one surface, one border. */
  .picker { margin-top: var(--s-11); }
  .tabs { display: flex; gap: var(--s-2); position: relative; z-index: 1;
    margin-bottom: -1px; padding: 0 var(--s-3); }
  .tab { display: inline-flex; align-items: center; gap: 7px; padding: 10px 18px;
    background: transparent; border: 1px solid transparent; border-bottom-color: var(--border-0);
    border-radius: var(--r-5) var(--r-5) 0 0;
    color: var(--fg-3); font-family: var(--font-sans); font-size: 14px; font-weight: 600;
    cursor: pointer; transition: color var(--t-fast), background var(--t-fast); }
  .tab:hover { color: var(--fg-1); }
  .tab:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }

  /* Selected tab + open panel both come off html[data-os], set before the
     panels are parsed — so the correct one is open at first paint. With JS off
     no attribute is ever set, and macOS opens as the fallback. */
  :global(html[data-os='macos']) .tab[data-os='macos'],
  :global(html[data-os='windows']) .tab[data-os='windows'],
  :global(html[data-os='linux']) .tab[data-os='linux'] {
    background: var(--bg-1); border-color: var(--border-0); border-bottom-color: var(--bg-1);
    color: var(--fg-0);
  }

  .panel { display: none; background: var(--bg-1); border: 1px solid var(--border-0);
    border-radius: var(--r-6); padding: var(--s-9); scroll-margin-top: 72px; }
  .panel:focus { outline: none; }
  :global(html[data-os='macos']) .panel[data-os-section='macos'],
  :global(html[data-os='windows']) .panel[data-os-section='windows'],
  :global(html[data-os='linux']) .panel[data-os-section='linux'] { display: block; }
  :global(html:not([data-os])) .panel[data-os-section='macos'] { display: block; }

  .panel-head { margin-bottom: var(--s-8); }
  /* The per-OS anchors the homepage links (/download/#macos) target this h2.
     72px only clears the nav, which parked the heading at the top with the tab
     row scrolled out of sight — so the control that had just been set for you
     was invisible. Clear the nav AND the tabs above it. */
  .panel-head h2 { font-size: 26px; margin: 0 0 var(--s-3); display: flex; align-items: center;
    gap: var(--s-4); scroll-margin-top: 150px; }
  .panel-head p { color: var(--fg-3); font-size: 14px; margin: 0; }

  /* ── cards ─────────────────────────────────────────────────── */
  /* The old page floated h3 + prose + code in open whitespace, capped at 760px
     inside a 1040px column — so nothing was grouped and a third of every row
     was dead margin. A grid uses the column, and a border says where a method
     starts and stops. */
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-6);
    align-items: start; }
  .card { background: var(--bg-0); border: 1px solid var(--border-0); border-radius: var(--r-6);
    padding: var(--s-7); min-width: 0; }
  .card-wide { grid-column: 1 / -1; }
  /* Exactly one card per panel carries the accent, so "recommended" means
     something. The old page gave the same left-border to Homebrew AND to
     "Updating with Homebrew", which flattened the distinction it was drawing. */
  .card-primary { border-color: color-mix(in oklab, var(--accent) 40%, var(--border-0));
    background: linear-gradient(180deg,
      color-mix(in oklab, var(--accent) 5%, var(--bg-0)), var(--bg-0) 55%); }

  .pill { display: inline-block; background: var(--accent); color: var(--accent-ink);
    font-family: var(--font-mono); font-size: 10px; font-weight: 700; letter-spacing: 0.06em;
    text-transform: uppercase; padding: 3px 8px; border-radius: 999px; margin-bottom: var(--s-5); }
  /* 15px sans headings read as captions above five lines of 14px prose. These
     are the labels a scanning reader navigates by, so they get the display face
     and enough size to win. */
  .card h3 { font-size: 19px; margin: 0 0 var(--s-3); color: var(--fg-0); }
  .card-lead { color: var(--fg-1); font-size: 14.5px; margin: 0 0 var(--s-6); line-height: 1.55; }
  .card-note { color: var(--fg-2); font-size: 13.5px; line-height: 1.65; margin: var(--s-5) 0 0; }
  .card-note-tight { margin-top: var(--s-6); }
  .card-note code, .card-lead code, .lead code, .matrix-note code, .mrow code {
    background: var(--bg-2); border: 1px solid var(--border-0); border-radius: var(--r-2);
    padding: 1px 5px; font-size: 12px; color: var(--fg-1); font-family: var(--font-mono); }
  .card-note a, .matrix-note a { color: var(--accent); }
  .filename { font-size: 11.5px; color: var(--fg-3); margin: var(--s-4) 0 0; }
  .card :global(.cta) { margin-top: var(--s-2); }
  /* A download button and a command are a sequence — get the file, then run the
     thing that consumes it — so they need air between them in either order. */
  .card :global(.codeblock) + :global(.cta) { margin-top: var(--s-5); }
  .card .filename + :global(.codeblock) { margin-top: var(--s-6); }

  /* ── the Store badge ───────────────────────────────────────── */
  /* The badge arrives over the network, and an undefined custom element is an
     inline box of zero height — so without a reservation the card grows by the
     badge's height whenever the CDN answers, shoving everything below it down.
     104px is the large badge's own height, taken from the component's `:host`
     rule, so the space is exactly filled rather than approximately. */
  .store-badge { display: flex; align-items: center; gap: var(--s-6); flex-wrap: wrap;
    min-height: 104px; margin-top: var(--s-2); }
  .store-badge ms-store-badge { display: inline-block; }
  /* Visible on its own terms, not only as a fallback: some readers would rather
     see where a button goes before they press it, and this is the one control
     on the page whose destination is off-site. */
  .store-link { color: var(--accent); font-size: 13.5px; }

  .card-specs { background: transparent; border-style: dashed; }
  .card-specs h3 { font-size: 13px; font-family: var(--font-mono); font-weight: 600;
    letter-spacing: 0.03em; text-transform: uppercase; color: var(--fg-3);
    margin-bottom: var(--s-5); }
  .card-specs ul { list-style: none; margin: 0; padding: 0; }
  .card-specs li { color: var(--fg-2); font-size: 13.5px; padding: var(--s-3) 0;
    border-top: 1px solid var(--border-0); }
  .card-specs li:first-child { border-top: none; padding-top: 0; }

  /* ── disclosures ───────────────────────────────────────────── */
  /* Gatekeeper flags, SmartScreen, upgrade commands: needed exactly once, by
     some readers. As top-level sections they made the page look like a manual;
     folded away they are still one click and one Ctrl+F from being found. */
  details { margin-top: var(--s-6); border-top: 1px solid var(--border-0); padding-top: var(--s-5); }
  summary { display: flex; align-items: center; gap: var(--s-4); cursor: pointer;
    color: var(--fg-1); font-size: 13px; font-weight: 600; list-style: none;
    font-family: var(--font-mono); }
  summary::-webkit-details-marker { display: none; }
  summary::before { content: '›'; display: inline-block; color: var(--accent);
    font-size: 16px; line-height: 1; transition: transform var(--t-med); }
  details[open] > summary::before { transform: rotate(90deg); }
  summary:hover { color: var(--fg-0); }
  summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: var(--r-2); }
  details :global(.codeblock) { margin-top: var(--s-5); }
  .audit { margin-top: var(--s-8); border: 1px solid var(--border-0); border-radius: var(--r-6);
    padding: var(--s-6) var(--s-7); }
  .audit[open] { padding-bottom: var(--s-7); }

  /* ── sections ──────────────────────────────────────────────── */
  .section { margin-top: var(--s-12); scroll-margin-top: 72px; }
  .section h2 { font-size: 30px; margin: 0 0 var(--s-5); }
  .section .lead { margin-bottom: var(--s-9); }
  .sub { font-size: 13px; font-family: var(--font-mono); font-weight: 600; letter-spacing: 0.03em;
    text-transform: uppercase; color: var(--fg-3); margin: 0 0 var(--s-5); }
  .grid-2 { margin-top: var(--s-9); }
  .readme-link { margin-top: var(--s-6); font-size: 14px; }

  /* ── pgit matrix ───────────────────────────────────────────── */
  /* Was a five-line paragraph a reader had to parse to answer "do I need to run
     anything?". It is a lookup with two answers, so it is a table. */
  .matrix { border: 1px solid var(--border-0); border-radius: var(--r-6); overflow: hidden; }
  .mrow { display: grid; grid-template-columns: minmax(0, 1.3fr) 92px minmax(0, 1.4fr);
    gap: var(--s-5); align-items: center; padding: var(--s-5) var(--s-6);
    border-top: 1px solid var(--border-0); font-size: 13.5px; }
  .mrow:first-child { border-top: none; }
  .mrow > span:first-child { display: flex; align-items: center; gap: var(--s-4);
    color: var(--fg-1); min-width: 0; }
  .mhead { background: var(--bg-1); font-family: var(--font-mono); font-size: 11px;
    letter-spacing: 0.04em; text-transform: uppercase; color: var(--fg-3); }
  .mhead > span:first-child { color: var(--fg-3); }
  .mhead code { background: none; border: none; padding: 0; font-size: 11px; color: inherit; }
  .ships { font-family: var(--font-mono); font-size: 12px; font-weight: 700; }
  [data-ships='true'] .ships { color: var(--git-added); }
  [data-ships='false'] .ships { color: var(--accent-2); }
  .mnote { color: var(--fg-3); font-size: 12.5px; }
  .matrix-note { color: var(--fg-2); font-size: 13.5px; line-height: 1.65;
    margin: var(--s-6) 0 0; max-width: 720px; }

  /* ── responsive ────────────────────────────────────────────── */
  @media (max-width: 860px) {
    .grid { grid-template-columns: minmax(0, 1fr); }
    .card-wide { grid-column: auto; }
  }
  @media (max-width: 720px) {
    .page-head { padding-top: var(--s-11); }
    .page-head h1 { font-size: 32px; }
    .panel { padding: var(--s-7); }
    .panel-head h2, .section h2 { font-size: 22px; }
    .picker { margin-top: var(--s-10); }
    .section { margin-top: var(--s-11); }
    /* The matrix' third column is the first thing to go: it is a gloss, and the
       answer is the second column. */
    .mrow { grid-template-columns: minmax(0, 1fr) 64px; }
    .mnote { display: none; }
    .mhead > span:last-child { display: none; }
  }
  /* The nav becomes two rows at this width, so an anchored section landed
     underneath it with the 72px offset calibrated for the one-row bar. */
  @media (max-width: 640px) {
    .section, .panel { scroll-margin-top: 96px; }
    .panel-head h2 { scroll-margin-top: 180px; }
  }
  @media (max-width: 560px) {
    /* Three tabs at 18px side padding measured wider than a 360px content box.
       A three-column grid divides the row it has instead of demanding one. */
    .tabs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; padding: 0; }
    .tab { justify-content: center; padding: 10px 4px; font-size: 13px; gap: 5px;
      border-radius: var(--r-5) var(--r-5) 0 0; }
    .page-head h1 { font-size: 27px; }
    .panel { padding: var(--s-6); border-radius: var(--r-5); }
    .card { padding: var(--s-6); }
  }
</style>
