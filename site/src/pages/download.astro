---
import Layout from '../layouts/Layout.astro';
import CTAButton from '../components/CTAButton.astro';
import CodeBlock from '../components/CodeBlock.astro';
import OsIcon from '../components/OsIcon.astro';
import { site, assets } from '../data/site.ts';
import { descriptions, softwareApplicationSchema, ORIGIN } from '../data/seo.ts';

// The two installer URLs. Built from `site` in astro.config.mjs rather than
// spelled out, so the copy people pipe into a shell cannot drift from the
// canonical origin (the apex domain 301s to www — a redirect a reader of the
// command should not have to reason about). The files themselves are copied
// into public/ by scripts/copy-installers.mjs at build time; there is no
// committed second copy to fall behind scripts/install-pgit.*.
const installBase = Astro.site ?? new URL(ORIGIN);
const installShUrl = new URL('install-pgit.sh', installBase).href;
const installPs1Url = new URL('install-pgit.ps1', installBase).href;

const cliUnix = `curl -fsSL ${installShUrl} | sh`;
const cliWindows = `irm ${installPs1Url} | iex`;
const cliUnixAudit = `curl -fsSL ${installShUrl} -o install-pgit.sh
less install-pgit.sh        # read it, then run it
sh install-pgit.sh`;
const cliWindowsAudit = `irm ${installPs1Url} -OutFile install-pgit.ps1
notepad install-pgit.ps1    # read it, then run it
powershell -ExecutionPolicy Bypass -File .\\install-pgit.ps1`;

const buildSteps = `# Prerequisites: Node 22+, pnpm, Rust stable
#   macOS:   xcode-select --install
#   Linux:   libwebkit2gtk-4.1-dev build-essential libssl-dev
#   Windows: WebView2 + MSVC Build Tools

git clone ${site.repo}.git
cd platypusgit
pnpm install
pnpm tauri build   # produces .dmg / .msi / .deb / .AppImage`;
---
<Layout
  title={'Download ' + site.name + ' for Mac, Windows & Linux'}
  description={descriptions.download}
  schemas={[softwareApplicationSchema]}
>
  <section class="container page-head">
    <h1>Download</h1>
    <p class="lead">platypusgit runs on macOS, Windows, and Linux. Pick your platform below. Prebuilt binaries live on GitHub Releases.</p>
    <div class="head-ctas">
      <CTAButton href={site.releasesLatest} external>Latest release</CTAButton>
      <CTAButton href={site.releases} variant="secondary" external>All releases</CTAButton>
    </div>
    <div class="os-tabs" data-os-tabs>
      <button class="os-tab" data-os="macos" type="button"><OsIcon os="macos" size={15} /> macOS</button>
      <button class="os-tab" data-os="windows" type="button"><OsIcon os="windows" size={15} /> Windows</button>
      <button class="os-tab" data-os="linux" type="button"><OsIcon os="linux" size={15} /> Linux</button>
    </div>
  </section>

  <section class="container">
    <div class="notice">
      <strong>Builds are early but usable.</strong> Every published release attaches prebuilt
      binaries for all three platforms — macOS <code>.dmg</code>, Windows <code>.msi</code>,
      Linux <code>.deb</code> &amp; <code>.AppImage</code>. On macOS, prefer
      <a href="#macos">Homebrew</a> — it handles Gatekeeper and updates for you.
      The download buttons above always
      point at the <a href={site.releasesLatest} target="_blank" rel="noopener">latest release</a>;
      browse <a href={site.releases} target="_blank" rel="noopener">all releases</a>, or
      <a href="#build">build from source</a>.
    </div>
  </section>

  <!-- INSTALL: macOS -->
  <section class="container install" id="macos" data-os-section="macos">
    <div class="install-head">
      <h2><OsIcon os="macos" size={22} /> macOS</h2>
      <p>Apple Silicon &amp; Intel. Homebrew is the smoothest route — one command to install, one to update, no Gatekeeper detour.</p>
    </div>

    <div class="method method-primary">
      <h3>Homebrew <span class="badge">Recommended</span></h3>
      <CodeBlock code={'brew install --cask jonassaa/platypusgit/platypusgit'} lang="bash" />
      <p class="method-note">Taps the cask and installs the universal build straight into <code>/Applications</code> — and the <a href="#cli"><code>pgit</code> command</a> with it. The app is ad-hoc signed but not notarized — the cask clears the macOS Gatekeeper quarantine flag on install, so it launches with no "unidentified developer" prompt and there is nothing to run by hand.</p>
    </div>

    <div class="method method-primary">
      <h3>Updating with Homebrew</h3>
      <p class="method-note">Homebrew owns updates on macOS — there is no in-app self-update here. Every release bumps the cask, so upgrading is:</p>
      <CodeBlock code={'brew update\nbrew upgrade --cask platypusgit'} lang="bash" />
      <p class="method-note"><code>brew update</code> refreshes the tap, <code>brew upgrade</code> fetches the new build and replaces the app. Quit platypusgit first so the running app isn't swapped underneath it. Check what you have with <code>brew info --cask platypusgit</code>, and remove it with <code>brew uninstall --cask platypusgit</code>.</p>
    </div>

    <div class="method">
      <h3>DMG (manual)</h3>
      <p class="method-note">No Homebrew? Download the universal <code>.dmg</code> and drag <code>PlatypusGit.app</code> into <code>/Applications</code>. Updates are then manual — repeat the download for every release. A drag-install runs no code, so the <a href="#cli"><code>pgit</code> command</a> is a separate one-liner.</p>
      <CTAButton href={assets.macosDmg} external>Download .dmg</CTAButton>
    </div>

    <div class="method">
      <h3>First launch — DMG only</h3>
      <p class="method-note">The <code>.dmg</code> isn't notarized, so on first launch macOS may say the app is damaged or from an unidentified developer. Clear the quarantine flag (Homebrew installs never hit this):</p>
      <CodeBlock code={'xattr -cr /Applications/PlatypusGit.app'} lang="bash" />
      <p class="method-note">Or: <strong>System Settings → Privacy &amp; Security → Open Anyway</strong> for platypusgit.</p>
    </div>
  </section>

  <!-- INSTALL: Windows -->
  <section class="container install" id="windows" data-os-section="windows">
    <div class="install-head">
      <h2><OsIcon os="windows" size={20} /> Windows</h2>
      <p>Windows 10 &amp; 11. WebView2 ships with Windows 11.</p>
    </div>

    <div class="method">
      <h3>Installer (.msi)</h3>
      <p class="method-note">Download the 64-bit <code>.msi</code> and run it. It installs the <a href="#cli"><code>pgit</code> command</a> too, and puts it on your PATH.</p>
      <CTAButton href={assets.windowsMsi} external>Download .msi</CTAButton>
    </div>

    <div class="method">
      <h3>First launch — unsigned build</h3>
      <p class="method-note">The installer isn't code-signed yet, so Windows SmartScreen shows a warning. Click <strong>More info → Run anyway</strong> to proceed.</p>
    </div>
  </section>

  <!-- INSTALL: Linux -->
  <section class="container install" id="linux" data-os-section="linux">
    <div class="install-head">
      <h2><OsIcon os="linux" size={22} /> Linux</h2>
      <p>Needs <code>webkit2gtk 4.1</code>. Two formats — Debian package or portable AppImage.</p>
    </div>

    <div class="method">
      <h3>Debian / Ubuntu (.deb)</h3>
      <p class="method-note">Download the package, then install it — it ships <code>/usr/bin/pgit</code>, so the <a href="#cli"><code>pgit</code> command</a> works straight away:</p>
      <CodeBlock code={'sudo apt install ./PlatypusGit_amd64.deb'} lang="bash" />
      <CTAButton href={assets.linuxDeb} external>Download .deb</CTAButton>
    </div>

    <div class="method">
      <h3>AppImage (portable)</h3>
      <p class="method-note">Download, make it executable, and run — no install needed. Nothing is installed, so the <a href="#cli"><code>pgit</code> command</a> is a separate one-liner:</p>
      <CodeBlock code={'chmod +x PlatypusGit_amd64.AppImage\n./PlatypusGit_amd64.AppImage'} lang="bash" />
      <CTAButton href={assets.linuxAppImage} external>Download .AppImage</CTAButton>
    </div>
  </section>

  <!-- THE pgit COMMAND -->
  <section class="container cli" id="cli">
    <h2>The <code>pgit</code> command</h2>
    <p class="lead"><code>pgit .</code> opens the repository you are standing in and hands the prompt straight back. <code>pgit log</code>, <code>pgit commit</code> and <code>pgit branches</code> open onto that screen; a path opens the repository containing it.</p>

    <div class="notice">
      <strong>Most installs already have it.</strong> The Homebrew cask, the Linux
      <code>.deb</code> and the Windows <code>.msi</code> install <code>pgit</code> as part of
      installing the app, and remove it again when you uninstall — there is nothing to run and
      nothing to copy. Check with <code>pgit --help</code> in a new terminal. Only the macOS
      <code>.dmg</code> and the Linux <code>.AppImage</code> run no install code — a drag-install
      and a portable AppImage never execute a hook — so those two need the command below, or
      <strong>Settings → Command line</strong> inside the app.
    </div>

    <div class="method">
      <h3>macOS DMG &amp; Linux AppImage</h3>
      <CodeBlock code={cliUnix} lang="bash" />
      <p class="method-note">Links <code>pgit</code> to the app you already installed, from a directory you own — no <code>sudo</code>. If Homebrew or the <code>.deb</code> already put a <code>pgit</code> on your PATH, the script says so and exits without touching it.</p>
    </div>

    <div class="method">
      <h3>Windows PowerShell</h3>
      <CodeBlock code={cliWindows} lang="powershell" />
      <p class="method-note">For the Windows installs the <code>.msi</code> does not cover: a build from source, an unpacked layout, or an <code>.msi</code> whose PATH change has not reached the shell you are in. Writes <code>pgit.cmd</code> into <code>%LOCALAPPDATA%\PlatypusGit\bin</code> and appends that directory to your <em>user</em> PATH — no admin rights, and nothing the machine PATH has to be edited for.</p>
    </div>

    <div class="method">
      <h3>Read it before you run it</h3>
      <p class="method-note">Piping a URL into a shell runs whatever that URL returns, so both scripts are plain text meant to be read first — <a href={installShUrl}>install-pgit.sh</a> and <a href={installPs1Url}>install-pgit.ps1</a> open in the browser, and the same files live in the repo under <a href={site.repo + '/tree/main/scripts'} target="_blank" rel="noopener">scripts/</a> (the site serves a build-time copy of exactly those bytes). Or download, inspect, then run:</p>
      <CodeBlock code={cliUnixAudit} lang="bash" />
      <p class="method-note method-note-tight">Windows PowerShell:</p>
      <CodeBlock code={cliWindowsAudit} lang="powershell" />
      <p class="method-note">Both take a dry run that prints what would happen and changes nothing: <code>curl -fsSL … | sh -s -- --dry-run</code>, or <code>-DryRun</code> for the PowerShell script.</p>
    </div>
  </section>

  <!-- BUILD FROM SOURCE -->
  <section class="container build" id="build">
    <h2>Build from source</h2>
    <p class="lead">Standard Tauri toolchain. Works on all three platforms.</p>
    <CodeBlock code={buildSteps} lang="bash" />
    <p class="readme-link"><a href={site.repo + '#development'} target="_blank" rel="noopener">Full development guide on GitHub →</a></p>
  </section>
</Layout>

<script>
  // OS selector: sniff platform (or honor #hash), show that install section.
  (function () {
    var sections = Array.from(document.querySelectorAll('[data-os-section]'));
    var tabs = Array.from(document.querySelectorAll('.os-tab'));
    if (!sections.length || !tabs.length) return;
    var known = ['macos', 'windows', 'linux'];

    function detect() {
      var hash = (location.hash || '').replace('#', '');
      if (known.indexOf(hash) !== -1) return hash;
      return 'macos';
    }

    function select(os) {
      sections.forEach(function (s) { s.hidden = s.getAttribute('data-os-section') !== os; });
      tabs.forEach(function (t) { t.classList.toggle('on', t.getAttribute('data-os') === os); });
    }

    tabs.forEach(function (t) {
      t.addEventListener('click', function () {
        var os = t.getAttribute('data-os');
        select(os);
        history.replaceState(null, '', '#' + os);
      });
    });

    select(detect());
    window.addEventListener('hashchange', function () {
      var hash = (location.hash || '').replace('#', '');
      if (known.indexOf(hash) !== -1) select(hash);
    });
  })();
</script>

<style>
  .page-head { padding-top: var(--s-12); }
  .os-tabs { display: inline-flex; margin-top: var(--s-8); border: 1px solid var(--border-1);
    border-radius: var(--r-5); overflow: hidden; }
  .os-tab { display: inline-flex; align-items: center; gap: 7px; padding: 8px 18px; background: transparent;
    border: none; border-right: 1px solid var(--border-1);
    color: var(--fg-2); font-family: var(--font-sans); font-size: 14px; font-weight: 600; cursor: pointer;
    transition: background var(--t-fast), color var(--t-fast); }
  .os-tab:last-child { border-right: none; }
  .os-tab:hover { color: var(--fg-0); }
  .os-tab.on { background: var(--accent); color: var(--accent-ink); }
  [data-os-section][hidden] { display: none; }
  .page-head h1 { font-size: 38px; margin: 0 0 var(--s-4); }
  .lead { color: var(--fg-2); font-size: 16px; max-width: 640px; margin: 0; }
  .head-ctas { display: flex; gap: var(--s-4); margin-top: var(--s-7); flex-wrap: wrap; }
  .notice { background: color-mix(in oklab, var(--accent-2) 12%, transparent);
    border: 1px solid color-mix(in oklab, var(--accent-2) 40%, transparent);
    color: var(--fg-1); padding: var(--s-5) var(--s-6); border-radius: var(--r-5);
    margin: var(--s-10) 0 0; font-size: 14px; }
  .notice a { color: var(--accent); }

  .install { margin-top: var(--s-11); padding-bottom: var(--s-9); border-bottom: 1px solid var(--border-0); scroll-margin-top: 72px; }
  .install-head { margin-bottom: var(--s-7); }
  .install-head h2 { font-size: 26px; margin: 0 0 var(--s-2); display: flex; align-items: center; gap: var(--s-4); }
  .install-head p { color: var(--fg-3); font-size: 14px; margin: 0; }
  .os-glyph { width: 8px; height: 8px; border-radius: 999px; background: var(--accent); display: inline-block; }

  .method { margin-top: var(--s-7); max-width: 760px; }
  .method h3 { font-size: 15px; margin: 0 0 var(--s-4); color: var(--fg-0); font-family: var(--font-sans); font-weight: 600;
    display: flex; align-items: center; gap: var(--s-3); flex-wrap: wrap; }
  .method-primary { border-left: 2px solid var(--accent); padding-left: var(--s-6); }
  .badge { background: var(--accent); color: var(--accent-ink); font-size: 10px; font-weight: 700;
    letter-spacing: 0.04em; text-transform: uppercase; padding: 2px 7px; border-radius: 999px; }
  .method-note { color: var(--fg-2); font-size: 14px; margin: 0 0 var(--s-4); line-height: 1.6; }
  .method-note code { background: var(--bg-2); border: 1px solid var(--border-0); border-radius: var(--r-2);
    padding: 1px 5px; font-size: 12px; color: var(--fg-1); }
  .method-note a { color: var(--accent); }

  .cli { margin-top: var(--s-11); padding-bottom: var(--s-9); border-bottom: 1px solid var(--border-0); scroll-margin-top: 72px; }
  .cli h2 { font-size: 26px; margin: 0 0 var(--s-3); }
  /* .notice is written for the top of the page, where it opens a section. */
  .cli .notice { margin-top: var(--s-6); }
  /* A label directly above its own code block, not a paragraph of prose. */
  .method-note-tight { margin-top: var(--s-5); }

  .build { margin-top: var(--s-12); scroll-margin-top: 72px; }
  .build h2 { font-size: 26px; margin: 0 0 var(--s-3); }
  .build .lead { margin-bottom: var(--s-7); }
  .readme-link { margin-top: var(--s-6); font-size: 14px; }

  @media (max-width: 720px) {
    .page-head { padding-top: var(--s-11); }
    .page-head h1 { font-size: 30px; }
    .install-head h2, .build h2, .cli h2 { font-size: 22px; }
    .install { margin-top: var(--s-10); }
    .cli { margin-top: var(--s-10); }
    .build { margin-top: var(--s-11); }
    .notice { margin-top: var(--s-9); }
    .os-tabs { margin-top: var(--s-7); }
  }
  /* The nav becomes two rows at this width, so an anchored section landed
     underneath it with the 72px offset calibrated for the one-row bar. */
  @media (max-width: 640px) {
    .install, .build, .cli { scroll-margin-top: 96px; }
  }
  @media (max-width: 560px) {
    /* Three inline tabs at 18px side padding measured ~335px — wider than a
       360px phone's content box. A three-column grid divides the row it has
       instead of demanding one. */
    .os-tabs { display: grid; grid-template-columns: repeat(3, 1fr); width: 100%; }
    .os-tab { justify-content: center; padding: 9px 4px; font-size: 13px; gap: 5px; }
    .page-head h1 { font-size: 26px; }
    .method { margin-top: var(--s-6); }
    .method-primary { padding-left: var(--s-5); }
  }
</style>
