---
import '../styles/tokens.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.ts';
import {
  ORIGIN,
  OG_IMAGE,
  OG_IMAGE_ALT,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_WIDTH,
  descriptions,
} from '../data/seo.ts';

interface Props {
  title: string;
  description?: string;
  /** JSON-LD objects to embed. Homepage/download carry the app schema. */
  schemas?: Record<string, unknown>[];
}
const { title, description = descriptions.home, schemas = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Pages are served with a trailing slash (GitHub Pages 301s the bare form), so
// the canonical URL must carry one too — otherwise the tag points at a redirect.
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const canonical = new URL(path, ORIGIN).href;
const ogImage = new URL(OG_IMAGE, ORIGIN).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content={site.author} />
    <meta name="theme-color" content="#0d1013" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfcfe" media="(prefers-color-scheme: light)" />

    <link rel="icon" type="image/svg+xml" href={base + '/favicon.svg'} />
    <link rel="preload" href={base + '/fonts/inter-var.woff2'} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={base + '/fonts/jetbrains-mono-var.woff2'} as="font" type="font/woff2" crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={OG_IMAGE_ALT} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />

    {schemas.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}

    <script is:inline>
      (function () {
        var mode = 'dark';
        try {
          var stored = localStorage.getItem('pg-site-theme');
          if (stored === 'light' || stored === 'dark') {
            mode = stored;
          } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
            mode = 'light';
          }
        } catch (e) {}
        document.documentElement.setAttribute('data-theme-mode', mode);
      })();
    </script>
  </head>
  <body>
    <Nav />
    <main><slot /></main>
    <Footer />
  </body>
</html>
