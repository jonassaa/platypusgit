{
  "name": "platypusgit",
  "private": true,
  "version": "0.0.0",
  "description": "A cross-platform, developer-focused git desktop app built with Tauri 2 + React.",
  "license": "GPL-3.0-only",
  "author": "Jonas Aasberg <jonas.aasberg@clave.no>",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonassaa/platypusgit.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm test:e2e:build && pnpm test:e2e:run",
    "test:e2e:build": "pnpm tauri build --debug --no-bundle --features tauri/custom-protocol,e2e --config src-tauri/tauri.e2e.conf.json && mkdir -p e2e/.bin && cp src-tauri/target/debug/platypusgit e2e/.bin/platypusgit",
    "test:e2e:run": "wdio run e2e/wdio.conf.ts",
    "test:e2e:docker": "e2e/e2e-docker.sh"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@shikijs/langs-precompiled": "4.4.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.35.0",
    "node-diff3": "^3.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.6.0",
    "@wdio/cli": "^9.31.4",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.4",
    "@wdio/mocha-framework": "^9.31.2",
    "@wdio/tauri-service": "^1.3.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@wdio/native-utils": "2.5.0",
      "@babel/core": "^7.29.6",
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@2": "^2.1.2",
      "browserslist": "^4.28.7",
      "fast-xml-parser": "^5.10.1",
      "form-data": "^4.0.6",
      "ip-address": "^10.3.1",
      "js-yaml": "^4.3.1",
      "serialize-javascript": "^7.0.5",
      "undici@6": "^6.28.0",
      "undici@7": "^7.29.0",
      "ws": "^8.21.0"
    }
  }
}
